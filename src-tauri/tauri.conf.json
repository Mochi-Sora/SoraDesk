{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoraDesk",
  "version": "0.1.0",
  "identifier": "com.mochi-sora.soradesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SoraDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Desktop client for the SoraAgent runtime",
    "longDescription": "SoraDesk is a Tauri v2 desktop client for SoraAgent. Chat, sessions, calendar, memories, and settings over local, SSH, or direct-IP connections.",
    "copyright": "© 2026 Mochi-Sora",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNzdDNTI4RjZCQTZCRDQKUldUVWE3cjJLTVYzS2l3OENjbnRjU2o3NFNTL1hXQ1VjZjUvQzNWem1GM3N0SXRjVUw3SGJnMVoK",
      "endpoints": [
        "https://github.com/Mochi-Sora/SoraDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
